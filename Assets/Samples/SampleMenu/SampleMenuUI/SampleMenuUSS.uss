.button {
    background-color: #444;
    border-radius: 12px;
    padding: 12px 20px;
    margin: 8px 0;
    color: white;
    font-size: 18px;
    unity-font-style: bold;
    transition: background-color 0.2s, scale 0.2s;
}

/* When selected */
.button-hover {
    background-color: #666;
    border: 2px solid #00ffff;
    scale: 1.05;
}

/* Glow animation loop */
.button-glow {
    animation: glow-pulse 1.5s infinite ease-in-out;
}

@keyframes glow-pulse {
    0%   { box-shadow: 0 0 6px #00ffff; transform: scale(1.05); }
    50%  { box-shadow: 0 0 16px #00ffff; transform: scale(1.08); }
    100% { box-shadow: 0 0 6px #00ffff; transform: scale(1.05); }
}

/* Optional: confirmation state */
.button-confirmed {
    background-color: #00aa88;
    border: 2px solid #00ffff;
    transform: scale(1.1);
}

.main-container {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 20px;
    gap: 20px;
}

.gesture-column {
    flex: 1;
    align-items: center;
    justify-content: flex-start;
}

.info-column {
    flex: 2;
    justify-content: flex-start;
}